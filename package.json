{
  "name": "spotify-tizenbrew",
  "appName": "Spotify TV Mod",
  "version": "0.7.0",
  "description": "Spotify sul web player delle TV Samsung: interfaccia TV con telecomando, UA desktop.",
  "packageType": "mods",
  "websiteURL": "https://open.spotify.com",
  "main": "dist/userScript.js",
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackNext",
    "MediaTrackPrevious",
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
